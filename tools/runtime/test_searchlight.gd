extends SceneTree

func _initialize() -> void:
	call_deferred("_test")

func _test() -> void:
	var item: ItemResource = load("res://data/items/searchlight.tres")
	assert(item != null and item.id == &"searchlight")
	assert(item.size_class == ItemTraits.SizeClass.CARRIED and item.one_hand_held)
	var inventory := InventoryComponent.new()
	root.add_child(inventory)
	assert(inventory.try_add(item))
	assert(inventory.update_first_instance_state(&"searchlight", {"searchlight_on": true}))
	var restored := InventoryComponent.new()
	root.add_child(restored)
	restored.load_save_data(inventory.get_save_data())
	assert(bool(restored.get_first_instance_state(&"searchlight").get("searchlight_on", false)))
	var ledger := PickupLedger.new()
	root.add_child(ledger)
	ledger.record(&"searchlight_727_reception")
	var ledger_restored := PickupLedger.new()
	root.add_child(ledger_restored)
	ledger_restored.load_save_data(ledger.get_save_data())
	assert(ledger_restored.is_taken(&"searchlight_727_reception"))
	var prop := HeldSearchlight.new()
	root.add_child(prop)
	await process_frame
	assert(prop.lamp != null and prop.lamp.shadow_enabled)
	assert(prop.lamp.visible == false)
	assert(prop.find_child("OpticGlow", true, false) != null)
	prop.toggle()
	assert(prop.lamp.visible and prop.is_enabled())
	prop.apply_enabled(false)
	assert(not prop.lamp.visible)
	var model: Node3D = prop.find_child("Model", true, false)
	assert(model != null)
	assert(model.find_child("Searchlight_Lens", true, false) != null)
	prop.advance_inertia(1.0 / 60.0, Vector3.FORWARD, Vector3.ZERO)
	for i in range(25):
		prop.advance_inertia(1.0 / 60.0, Vector3.LEFT, Vector3(3, 0, 0))
	assert(prop.direction.angle_to(Vector3.LEFT) <= deg_to_rad(prop.maximum_angle_deg + 0.1))
	assert(prop.inertia_offset.length() <= prop.maximum_translation_m + 0.001)
	print("SEARCHLIGHT_SMOKE_OK")
	quit()
