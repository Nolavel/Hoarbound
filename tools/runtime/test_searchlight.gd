extends SceneTree

func _initialize() -> void:
	call_deferred("_test")

func _test() -> void:
	var item: ItemResource = load("res://data/items/searchlight.tres")
	assert(item != null and item.id == &"searchlight")
	assert(item.size_class == ItemTraits.SizeClass.CARRIED and item.one_hand_held)
	var inventory := InventoryComponent.new()
	root.add_child(inventory)
	assert(inventory.try_add(item))
	assert(inventory.update_first_instance_state(&"searchlight", {"searchlight_on": true}))
	assert(inventory.update_first_instance_state(&"searchlight", {"searchlight_runtime_hours": 24.0}))
	var restored := InventoryComponent.new()
	root.add_child(restored)
	restored.load_save_data(inventory.get_save_data())
	assert(bool(restored.get_first_instance_state(&"searchlight").get("searchlight_on", false)))
	assert(float(restored.get_first_instance_state(&"searchlight").get("searchlight_runtime_hours", -1.0)) == 24.0)
	var ledger := PickupLedger.new()
	root.add_child(ledger)
	ledger.record(&"searchlight_727_reception")
	var ledger_restored := PickupLedger.new()
	root.add_child(ledger_restored)
	ledger_restored.load_save_data(ledger.get_save_data())
	assert(ledger_restored.is_taken(&"searchlight_727_reception"))
	var prop := HeldSearchlight.new()
	root.add_child(prop)
	await process_frame
	assert(prop.lamp != null and prop.lamp.shadow_enabled)
	assert(prop.lamp.visible == false)
	assert(prop.charge_fraction() == 1.0 and prop.indicator_green_count() == 4)
	assert(prop.find_children("ChargeIndicator_*", "MeshInstance3D", true, false).size() == 4)
	assert(prop.find_child("OpticGlow", true, false) != null)
	prop.toggle()
	assert(prop.lamp.visible and prop.is_enabled())
	prop.apply_enabled(false)
	assert(not prop.lamp.visible)
	prop.set_runtime_hours(12.0)
	assert(prop.indicator_green_count() == 3)
	prop.set_runtime_hours(24.0)
	assert(prop.indicator_green_count() == 2)
	prop.set_runtime_hours(36.0)
	assert(prop.indicator_green_count() == 1)
	prop.set_runtime_hours(47.0)
	prop.apply_enabled(true)
	assert(prop.lamp.light_energy < prop.light_energy and prop.lamp.light_energy > 0.0)
	prop.set_runtime_hours(47.6)
	var saw_light: bool = false
	var saw_failure: bool = false
	for i in range(40):
		prop._process(0.1)
		saw_light = saw_light or prop.lamp.visible
		saw_failure = saw_failure or not prop.lamp.visible
	assert(saw_light and saw_failure)
	prop.set_runtime_hours(47.0)
	var held := HeldItemComponent.new()
	held.inventory = inventory
	root.add_child(held)
	held.set(&"_prop", prop)
	held.set(&"_item_id", &"searchlight")
	prop.toggled.connect(held._on_searchlight_toggled)
	held.advance_simulation(1.0, null)
	assert(prop.runtime_hours == HeldSearchlight.BATTERY_HOURS)
	assert(float(inventory.get_first_instance_state(&"searchlight").get("searchlight_runtime_hours", -1.0)) == 48.0)
	assert(not bool(inventory.get_first_instance_state(&"searchlight").get("searchlight_on", true)))
	assert(not prop.is_enabled() and not prop.lamp.visible)
	assert(prop.indicator_green_count() == 0)
	for led: Node in prop.find_children("ChargeIndicator_*", "MeshInstance3D", true, false):
		assert(not (led as MeshInstance3D).visible)
	prop.toggle()
	assert(not prop.is_enabled())
	var model: Node3D = prop.find_child("Model", true, false)
	assert(model != null)
	assert(model.find_child("Searchlight_Lens", true, false) != null)
	prop.advance_inertia(1.0 / 60.0, Vector3.FORWARD, Vector3.ZERO)
	for i in range(25):
		prop.advance_inertia(1.0 / 60.0, Vector3.LEFT, Vector3(3, 0, 0))
	assert(prop.direction.angle_to(Vector3.LEFT) <= deg_to_rad(prop.maximum_angle_deg + 0.1))
	assert(prop.inertia_offset.length() <= prop.maximum_translation_m + 0.001)
	print("SEARCHLIGHT_SMOKE_OK")
	quit()
