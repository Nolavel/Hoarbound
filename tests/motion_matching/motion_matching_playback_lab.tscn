[sub_resource type="Shader" id="GridShader"]
code = "shader_type spatial;
render_mode specular_disabled;

uniform vec3 base_color = vec3(0.17, 0.19, 0.21);
uniform vec3 line_color = vec3(0.36, 0.39, 0.43);
varying vec3 world_position;

void vertex() {
	world_position = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	vec2 minor_cell = abs(fract(world_position.xz - 0.5) - 0.5) / fwidth(world_position.xz);
	float minor = 1.0 - min(min(minor_cell.x, minor_cell.y), 1.0);
	vec2 major_cell = abs(fract(world_position.xz * 0.2 - 0.5) - 0.5) / fwidth(world_position.xz * 0.2);
	float major = 1.0 - min(min(major_cell.x, major_cell.y), 1.0);
	ALBEDO = mix(base_color, line_color, max(minor * 0.55, major));
	ROUGHNESS = 0.95;
}
"

