#!/usr/bin/env python
import os
import sys


local_env = Environment(tools=["default"], PLATFORM="")
options = Variables([], ARGUMENTS)
options.Update(local_env)

if not os.path.isdir("godot-cpp"):
	print("godot-cpp is missing; the CI workflow fetches the pinned revision.", file=sys.stderr)
	sys.exit(1)

env = SConscript(
	"godot-cpp/SConstruct",
	{"api_version": "4.7", "env": local_env, "customs": []},
)
env.Append(CPPPATH=["src", "../hoarbound_core"])

sources = Glob("src/*.cpp")
library_options = {}
if env["platform"] == "macos":
	library_options["SHLIBSUFFIX"] = ".macos.dylib"
library = env.SharedLibrary(
	"ci_project/bin/{}/hoarbound_native".format(env["platform"]),
	source=sources,
	**library_options,
)

Default(library)

