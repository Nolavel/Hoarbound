[internationalization]

locale/translations=PackedStringArray("res://localization/strings.en.translation", "res://localization/strings.ru.translation")

[layer_names]

3d_render/layer_5="henry_render"
3d_render/layer_6="gizmo_render"
3d_render/layer_19="snow_contact"
3d_render/layer_20="dev_map_label"
3d_physics/layer_1="ground"

[physics]

common/physics_interpolation=true

[rendering]

textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
anti_aliasing/quality/msaa_2d=1
scaling_3d/mode=1
scaling_3d/scale=0.77
anti_aliasing/quality/screen_space_aa=1

[shader_globals]

snow_cover={
"type": "float",
"value": 0.5
}
snow_settled_depth={
"type": "float",
"value": 0.15
}
snow_drift_m={
"type": "float",
"value": 0.1
}
snow_wind={
"type": "vec2",
"value": Vector2(0, -1)
}
snow_window={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
frost_amount={
"type": "float",
"value": 0.3
}
snow_storm_share={
"type": "float",
"value": 0.4
}
stylized_shadow_strength={
"type": "float",
"value": 1.0
}
stylized_shadow_brush_mask={
"type": "sampler2D",
"value": "res://assets/textures/shadows/shadow_brush_dry.png"
}
stylized_shadow_brush_mix={
"type": "float",
"value": 1.0
}
