; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hoarbound"
config/tags=[]
run/main_scene="res://scenes/world/key_west/key_west.tscn"
config/features=PackedStringArray("4.8", "C#", "Forward Plus")
boot_splash/bg_color=Color(0.0627451, 0.0627451, 0.0627451, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

PlayerState="*res://core/player_state/player_state.gd"
InputSystems="*res://core/input/input_systems.gd"
SoundSystem="*res://core/audio/sound_system.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=1920.0
window/size/viewport_height=1080.0
window/size/mode=3
window/size/initial_position_type=1.0
window/size/initial_position="(0, 0)"
window/size/borderless=true
window/stretch/mode="viewport"
window/vsync/vsync_mode=1.0

[dotnet]

project/assembly_name="Hoarbound"
project/assembly_reload_attempts=3.0

[editor]

version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg", "res://addons/item_fitter/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "yellow",
"res://autoloads/": "purple",
"res://components/": "orange",
"res://docs/": "blue",
"res://garbage/": "red",
"res://levels/": "gray",
"res://scenes/": "green",
"res://scripts/": "orange",
"res://tests/": "pink"
}

[global_group]

interactables=""

[gui]

theme/custom_font="res://assets/fonts/IM Fell English SC/IMFellEnglishSC-Regular.ttf"

[hfn]

snow/quality="high"

[importer_defaults]

animation_library={
"animation/import_rest_as_RESET": true,
"animation/trimming": true,
"fbx/allow_geometry_helper_nodes": true,
"nodes/import_as_skeleton_bones": true
}

